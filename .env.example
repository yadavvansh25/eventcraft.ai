# EventCraft AI Configuration Template
# Do NOT commit actual secrets or API keys to version control.

PORT=3000
NODE_ENV=development

# Sliding-Window Rate Limiting Controls
EVENTCRAFT_RATE_LIMIT_MAX=60
EVENTCRAFT_RATE_LIMIT_WINDOW_MS=60000

# High-Performance LRU Plan Cache
EVENTCRAFT_CACHE_CAPACITY=200
EVENTCRAFT_CACHE_TTL_MS=3600000

# Optional Model Provider Configuration (if delegating outside deterministic mock)
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here
